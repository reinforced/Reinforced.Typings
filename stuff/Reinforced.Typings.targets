<Project DefaultTargets="Build"
	xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<PropertyGroup Condition="'$(RtSettingsXml)' == ''">
		<RtSettingsXml Condition="HasTrailingSlash('$(ProjectDir)')">$(ProjectDir)Reinforced.Typings.settings.xml</RtSettingsXml>
		<RtSettingsXml Condition="!HasTrailingSlash('$(ProjectDir)')">$(ProjectDir)\Reinforced.Typings.settings.xml</RtSettingsXml>
	</PropertyGroup>

	<PropertyGroup>
		<RtTargetsPath Condition=" '$(MSBuildRuntimeType)' == 'Core'">netstandard2.0</RtTargetsPath>
		<RtTargetsPath Condition=" '$(MSBuildRuntimeType)' != 'Core'">net46</RtTargetsPath>
	</PropertyGroup>

	<PropertyGroup Condition="Exists($(RtSettingsXml))">
		<TargetsTriggeredByCompilation>
			$(TargetsTriggeredByCompilation);ReinforcedTypingsGenerate;
		</TargetsTriggeredByCompilation>

		<BuildDependsOn>
			ConditionallyDisableTypeScriptCompilation;
			ConditionallyShowDisabledWarning;
			$(BuildDependsOn);
		</BuildDependsOn>
	</PropertyGroup>
	<ImportGroup Condition="Exists($(RtSettingsXml))">
		<Import Project="$(RtSettingsXml)" />
	</ImportGroup>


	<UsingTask TaskName="Reinforced.Typings.Integrate.RtCli" AssemblyFile="$(RtTargetsPath)\Reinforced.Typings.Integrate.dll" />
	<UsingTask TaskName="Reinforced.Typings.Integrate.RemoveTypescriptStep" AssemblyFile="$(RtTargetsPath)\Reinforced.Typings.Integrate.dll" />

	<Target Name="ConditionallyDisableTypeScriptCompilation" Condition="'$(RtBypassTypeScriptcompilation)' != 'false'">
		<Message Text="TypeScript sources will not be built before project compile because it is disabled in Reinforced.Typings.settings.xml or an overriding property setting."/>
		<!-- Each property below is only defined by certain project SDKs/pipelines; MSBuild treats an
		     empty-string value for a [Required] task parameter as "not given", so guard every call
		     with a not-empty Condition to avoid MSB4044 on projects where the property doesn't exist. -->
		<RemoveTypeScriptStep Original="$(CompileDependsOn)" Condition="'$(CompileDependsOn)' != ''">
			<Output PropertyName="CompileDependsOn" TaskParameter="Fixed"/>
		</RemoveTypeScriptStep>
		<RemoveTypeScriptStep Original="$(PublishPipelineCollectFilesCore)" Condition="'$(PublishPipelineCollectFilesCore)' != ''">
			<Output PropertyName="PublishPipelineCollectFilesCore" TaskParameter="Fixed"/>
		</RemoveTypeScriptStep>
		<RemoveTypeScriptStep Original="$(BuiltProjectOutputGroupDependsOn)" Condition="'$(BuiltProjectOutputGroupDependsOn)' != ''">
			<Output PropertyName="BuiltProjectOutputGroupDependsOn" TaskParameter="Fixed"/>
		</RemoveTypeScriptStep>
		<!-- Microsoft.TypeScript.MSBuild 7+ (tsgo) hooks TypeScript compilation into CoreCompileDependsOn instead -->
		<RemoveTypeScriptStep Original="$(CoreCompileDependsOn)" Condition="'$(CoreCompileDependsOn)' != ''">
			<Output PropertyName="CoreCompileDependsOn" TaskParameter="Fixed"/>
		</RemoveTypeScriptStep>
	</Target>
	<Target Name="ConditionallyShowDisabledWarning" Condition="'$(RtDisable)' != 'false'">
		<Message Text="Reinforced.Typings will not run because it is disabled in Reinforced.Typings.settings.xml or an overriding property setting."/>
	</Target>
	<Target Name="ReinforcedTypingsGenerate" Condition="'$(BuildingProject)' != 'false' And '$(RtDisable)' == 'false'">
		<RtCli
			BuildDirectory="$(MSBuildThisFileDirectory)"
			TargetFramework="$(TargetFramework)"
			RtForceTargetFramework="$(RtForceTargetFramework)"
			SourceAssembly="@(IntermediateAssembly)"
			References="@(ReferencePath)"
			AdditionalSourceAssemblies="@(RtAdditionalAssembly)"
			ProjectRoot="$(ProjectDir)"
			
			TargetFile="$(RtTargetFile)"
			Hierarchical="$(RtDivideTypesAmongFiles)"
			TargetDirectory="$(RtTargetDirectory)"
			DocumentationFilePath="$(MSBuildProjectDirectory)\$(DocumentationFile)"
			ConfigurationMethod="$(RtConfigurationMethod)"
			SuppressedWarnings="$(RtSuppress)"
		/>
		<MSBuild Projects="$(MSBuildProjectFullPath)" Properties="INeedThis=JustToRebuildTypescripts;BuildingProject=true" Targets="CompileTypeScript" Condition="'$(TypeScriptTarget)' != '' AND '@(ConfigFiles)' == '' AND '$(UsingMicrosoftTsGo)' != 'true'" />
		<MSBuild Projects="$(MSBuildProjectFullPath)" Properties="INeedThis=JustToRebuildTypescripts;BuildingProject=true" Targets="CompileTypeScriptWithTSConfig" Condition="'$(TypeScriptTarget)' != '' AND '@(ConfigFiles)' != '' AND '$(UsingMicrosoftTsGo)' != 'true'" />
		<!-- Microsoft.TypeScript.MSBuild 7+ (tsgo) renamed CompileTypeScript/CompileTypeScriptWithTSConfig to SetTscExecutable+RunTscCompile, which handles tsconfig.json internally -->
		<MSBuild Projects="$(MSBuildProjectFullPath)" Properties="INeedThis=JustToRebuildTypescripts;BuildingProject=true" Targets="SetTscExecutable;RunTscCompile" Condition="'$(TypeScriptTarget)' != '' AND '$(UsingMicrosoftTsGo)' == 'true'" />
	</Target>
</Project>